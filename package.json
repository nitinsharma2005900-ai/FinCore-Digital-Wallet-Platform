{
  "name": "fincore", "version": "1.0.0", "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev -w @fincore/web", "dev:api": "tsx apps/api/src/server.ts", "dev:worker": "tsx apps/worker/src/index.ts",
    "db:generate": "prisma generate --schema database/schema.prisma", "db:migrate": "tsx scripts/migrate.ts", "db:seed": "tsx database/seeds/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @fincore/web",
    "lint": "eslint apps packages scripts tests database/seeds",
    "test": "vitest run --coverage", "test:e2e": "playwright test", "capstone": "tsx scripts/capstone.ts",
    "build": "tsc -p tsconfig.build.json && npm run build -w @fincore/web",
    "docs": "tsx scripts/contracts.ts", "start:api": "node dist/apps/api/src/server.js", "start:worker": "node dist/apps/worker/src/index.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3", "bcryptjs": "^3.0.2", "bullmq": "^5.61.0", "cookie-parser": "^1.4.7", "cors": "^2.8.5", "decimal.js": "^10.6.0", "dotenv": "^17.2.3", "express": "^5.1.0", "express-rate-limit": "^8.1.0", "helmet": "^8.1.0", "ioredis": "^5.8.2", "jsonwebtoken": "^9.0.2", "nodemailer": "^7.0.10", "pdfkit": "^0.17.2", "pino": "^10.1.0", "stripe": "^19.1.0", "swagger-ui-express": "^5.0.1", "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1", "@playwright/test": "^1.56.1", "@testing-library/jest-dom": "^6.9.1", "@testing-library/react": "^16.3.0", "@types/bcryptjs": "^2.4.6", "@types/cookie-parser": "^1.4.10", "@types/cors": "^2.8.19", "@types/express": "^5.0.5", "@types/jsonwebtoken": "^9.0.10", "@types/node": "^22.18.0", "@types/nodemailer": "^7.0.3", "@types/pdfkit": "^0.17.3", "@types/supertest": "^6.0.3", "@types/swagger-ui-express": "^4.1.8", "@vitest/coverage-v8": "^3.2.4", "eslint": "^9.39.1", "jsdom": "^27.2.0", "prisma": "6.19.3", "supertest": "^7.1.4", "tsx": "^4.20.6", "typescript": "^5.9.3", "typescript-eslint": "^8.46.3", "vitest": "^3.2.4"
  }
}
